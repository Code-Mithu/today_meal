# Provisioned automatically by the connected Neon integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required Django production configuration.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Set this to the deployed Vercel backend URL for Android builds.
EXPO_PUBLIC_API_URL=https://your-project.vercel.app
