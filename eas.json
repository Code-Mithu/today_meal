{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://base44-mobile-app-6.vercel.app"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://base44-mobile-app-6.vercel.app"
      },
      "android": { "buildType": "app-bundle" }
    }
  }
}
